{
  "buildLog": {
    "entries": [
      {
        "annotation": {
          "ingestContent": {
            "content": "2.1 Every person has exactly one role: enrolled student, staff, or visitor."
          }
        },
        "status": "APPLIED",
        "buildSteps": [
          {
            "context": {
              "mutation": {
                "addType": {
                  "type": {
                    "name": "role",
                    "description": "The role assigned to a person. Every person has exactly one role.",
                    "values": [
                      {
                        "value": "enrolled student",
                        "description": "A person who is an enrolled student."
                      },
                      {
                        "value": "staff",
                        "description": "A person who is a member of staff."
                      },
                      {
                        "value": "visitor",
                        "description": "A person who is a visitor."
                      },
                      {
                        "value": "role_OTHER",
                        "description": "A role that is not one of the modeled roles (enrolled student, staff, or visitor)."
                      }
                    ]
                  }
                }
              }
            },
            "messages": []
          }
        ]
      },
      {
        "annotation": {
          "ingestContent": {
            "content": "2.2 A person's safety training is either current or not current. Training that has expired, or that was never completed, is not current."
          }
        },
        "status": "APPLIED",
        "buildSteps": [
          {
            "context": {
              "mutation": {
                "addType": {
                  "type": {
                    "name": "safetyTraining",
                    "description": "The status of a person's safety training. It is either current or not current. Training that has expired or was never completed is not current.",
                    "values": [
                      {
                        "value": "current",
                        "description": "The person's safety training is current."
                      },
                      {
                        "value": "notCurrent",
                        "description": "The person's safety training is not current, including training that has expired or was never completed."
                      },
                      {
                        "value": "safetyTraining_OTHER",
                        "description": "A safety training status that is not one of the modeled states (current or not current)."
                      }
                    ]
                  }
                }
              }
            },
            "messages": []
          },
          {
            "context": {
              "mutation": {
                "addVariable": {
                  "variable": {
                    "name": "personRole",
                    "type": "role",
                    "description": "The role assigned to a person: enrolled student, staff, or visitor."
                  }
                }
              }
            },
            "messages": []
          },
          {
            "context": {
              "mutation": {
                "addVariable": {
                  "variable": {
                    "name": "personSafetyTraining",
                    "type": "safetyTraining",
                    "description": "The status of a person's safety training: current or not current."
                  }
                }
              }
            },
            "messages": []
          },
          {
            "context": {
              "mutation": {
                "addVariable": {
                  "variable": {
                    "name": "isCheckoutAllowed",
                    "type": "BOOL",
                    "description": "Whether the person may check out lab equipment. True if and only if the person is permitted to check out lab equipment."
                  }
                }
              }
            },
            "messages": []
          },
          {
            "context": {
              "mutation": {
                "addRule": {
                  "rule": {
                    "id": "QGMYAGJKT7J2",
                    "expression": "(not (= personRole\n        role_OTHER))",
                    "alternateExpression": "A person's role must be one of the modeled roles: enrolled student, staff, or visitor (it cannot be the OTHER value)."
                  }
                }
              }
            },
            "messages": []
          },
          {
            "context": {
              "mutation": {
                "addRule": {
                  "rule": {
                    "id": "OIZMBJJ6G4UJ",
                    "expression": "(not (= personSafetyTraining\n        safetyTraining_OTHER))",
                    "alternateExpression": "A person's safety training status must be one of the modeled states: current or not current (it cannot be the OTHER value)."
                  }
                }
              }
            },
            "messages": []
          },
          {
            "context": {
              "mutation": {
                "addRule": {
                  "rule": {
                    "id": "ARRA2L9ULR5X",
                    "expression": "(= isCheckoutAllowed\n   (and (or (= personRole\n               |enrolled student|)\n            (= personRole staff))\n        (= personSafetyTraining\n           current)))",
                    "alternateExpression": "A person may check out lab equipment if and only if their role is enrolled student or staff, and their safety training is current."
                  }
                }
              }
            },
            "messages": []
          },
          {
            "context": {
              "mutation": {
                "addRule": {
                  "rule": {
                    "id": "YWM8XVXCPHSL",
                    "expression": "(=> (= personRole visitor)\n    (not isCheckoutAllowed))",
                    "alternateExpression": "Visitors cannot check out lab equipment, regardless of their safety training."
                  }
                }
              }
            },
            "messages": []
          },
          {
            "context": {
              "mutation": {
                "addRule": {
                  "rule": {
                    "id": "XXSD0Z98EYAR",
                    "expression": "(=> (= personSafetyTraining\n       notCurrent)\n    (not isCheckoutAllowed))",
                    "alternateExpression": "A person whose safety training is not current cannot check out lab equipment, regardless of their role."
                  }
                }
              }
            },
            "messages": []
          }
        ]
      },
      {
